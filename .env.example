# ─────────────────────────────────────────────
# Cut 90 Planner — Environment Variables
# Copy this file to .env and fill in real values
# ─────────────────────────────────────────────

# REQUIRED: random string >= 32 chars for signing session cookies
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_random_64_hex_chars

# Domain served by Caddy (no protocol prefix)
# Local dev: localhost | Production: yourdomain.com
APP_DOMAIN=localhost

# Full origin URL (used for CORS / CSRF checks)
APP_ORIGIN=http://localhost

# Set to false to close public registration
ALLOW_SIGNUP=true

# Optional: require this code to sign up (only checked when ALLOW_SIGNUP=true)
# INVITE_CODE=

# Session cookie name (can leave as default)
SESSION_COOKIE_NAME=cut90_session
